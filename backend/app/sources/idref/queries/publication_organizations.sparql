PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT
  ?org
  (SAMPLE(?org_name_val) AS ?org_name)
  ?org_relator
  (SAMPLE(?org_role_val) AS ?org_role)
WHERE {
  $publication ?org_relator ?org .
  ?org a foaf:Organization .
  OPTIONAL {
    ?org skos:prefLabel ?org_name_val .
    ?org_relator rdfs:label ?org_role_val .
  }
}
