institutions linked to a publication:

PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT
  ?org
(sample(?org_names) as $org_name)
  ?org_relator
(sample(?org_roles) as $org_role)
WHERE {
  BIND(<http://www.sudoc.fr/242351441/id> AS ?doc)

  OPTIONAL {
    ?doc ?org_relator ?org.
    ?org a foaf:Organization.
      ?org skos:prefLabel ?org_names.
    OPTIONAL {
      ?org_relator rdfs:label ?org_roles.
    }
  }
}
