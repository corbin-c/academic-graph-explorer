info about a publication:

PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX bibo: <http://purl.org/ontology/bibo/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT DISTINCT
  ?title
(sample(?doi) as ?doi)
  ?sameAs
  ?uri
WHERE {

  BIND(<http://www.sudoc.fr/242351441/id> AS ?doc)

  ?doc dcterms:bibliographicCitation ?title.

  OPTIONAL {
    ?doc bibo:doi ?dois.
  }
  OPTIONAL {
    ?doc owl:sameAs ?sameAs.
  }
  OPTIONAL {
  ?doc bibo:uri ?uri.
  }
}

