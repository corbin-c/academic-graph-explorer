PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX marcrel: <http://id.loc.gov/vocabulary/relators/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX bibo: <http://purl.org/ontology/bibo/>

SELECT DISTINCT ?title ?role ?doc ?auteur ?author_name WHERE {
?doc ?relator <http://www.idref.fr/121375307/id>; dcterms:bibliographicCitation ?title. 
?relator skos:prefLabel ?role.
?doc marcrel:aut ?auteur.
?auteur skos:prefLabel ?auth_name.
} group by ?doc
